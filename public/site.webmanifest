{
    "background_color": "#f3f4f6",
    "description": "跨平台 LRC 歌词编辑与时间轴制作工具",
    "display": "standalone",
    "icons": [
        {
            "sizes": "192x192",
            "src": "./favicons/android-chrome-192x192.png",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "sizes": "512x512",
            "src": "./favicons/android-chrome-512x512.png",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ],
    "name": "LRC Editor",
    "short_name": "LRC Editor",
    "start_url": "./",
    "theme_color": "#191a1f",
    "share_target": {
        "action": "./",
        "method": "GET",
        "enctype": "application/x-www-form-urlencoded",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}
