{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "0.4.6",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "minimum_chrome_version": "120",
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "action": {
        "default_title": "__MSG_extensionName__",
        "default_popup": "popup-mobile.html"
    },
    "permissions": [
        "declarativeNetRequestWithHostAccess",
        "webRequest"
    ],
    "host_permissions": [
        "https://www.youtube.com/*",
        "https://youtubei.googleapis.com/*",
        "https://*.googlevideo.com/*",
        "https://api.bilibili.com/*",
        "https://www.bilibili.com/*",
        "https://b23.tv/*",
        "https://*.bilivideo.com/*",
        "https://163cn.tv/*",
        "https://music.163.com/*",
        "https://*.music.163.com/*",
        "http://*.music.126.net/*",
        "https://*.music.126.net/*",
        "https://c6.y.qq.com/*",
        "https://i.y.qq.com/*",
        "https://i2.y.qq.com/*",
        "https://aqqmusic.tc.qq.com/*",
        "https://lrc.sgmy.org/*",
        "https://samgum.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "media_headers",
                "enabled": true,
                "path": "rules/bilibili-media.json"
            }
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://lrc.sgmy.org/*",
                "https://samgum.github.io/lrc-editor/*",
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": [
                "bridge.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://i2.y.qq.com/n3/other/pages/playsong/index.html*"
            ],
            "js": [
                "qqmusic-frame.js"
            ],
            "all_frames": true,
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png",
        "192": "icons/icon-192.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://c6.y.qq.com https://i.y.qq.com https://i2.y.qq.com https://lrc.sgmy.org https://samgum.github.io http://localhost http://127.0.0.1"
    }
}
